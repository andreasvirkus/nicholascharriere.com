---
import { ViewTransitions } from "astro:transitions";
import HalfMoon from "../icons/HalfMoon.astro";
import SunLight from "../icons/SunLight.astro";
interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, image, noindex } = Astro.props || { title: "Nicholas Charriere" };
const { description } = Astro.props || {
  description: "The personal website of Nicholas Charriere.",
};
const ogImage = image || "https://nicholascharriere.com/nicholas2.jpg";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />
    <meta
      name="keywords"
      content="Nicholas Charriere,Srcbook,founder,personal page nicholas charriere,programmer AI"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Nicholas Charriere" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@nichochar" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={ogImage}
    /><link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="any" />
    <meta name="next-size-adjust" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Nicholas Charriere"
      href="/rss.xml"
    />
    <meta name="generator" content={Astro.generator} />

    <style is:global>
      :root {
        --color-page: #ffffff;
        --color-heading: #222222;
        --color-body: #444444;
        --color-link: #3273dc;
      }
      html.dark {
        --color-page: #01242e;
        --color-heading: #eeeeee;
        --color-body: #dddddd;
        --color-link: #8cc2dd;
      }
      html.dark a:visited {
        color: #8b6fcb;
      }
    </style>

    <!-- Two-state theme toggle (Verou pattern): system by default, override stored, toggling back to the OS value clears it -->
    <script is:inline>
      (function () {
        function systemDark() {
          return window.matchMedia("(prefers-color-scheme: dark)").matches;
        }
        function apply() {
          var stored = null;
          try {
            stored = localStorage.getItem("theme");
          } catch (e) {}
          var dark = stored === "dark" || (!stored && systemDark());
          document.documentElement.classList.toggle("dark", dark);
        }
        window.__toggleTheme = function () {
          var resolvedDark = document.documentElement.classList.contains("dark");
          var target = resolvedDark ? "light" : "dark";
          var sys = systemDark() ? "dark" : "light";
          try {
            if (target === sys) {
              localStorage.removeItem("theme");
            } else {
              localStorage.setItem("theme", target);
            }
          } catch (e) {}
          apply();
        };
        // Run before paint to avoid a flash of the wrong theme
        apply();
        // Follow the OS live only when no override is stored (never clears an override)
        try {
          window
            .matchMedia("(prefers-color-scheme: dark)")
            .addEventListener("change", apply);
        } catch (e) {}
        // Re-apply after Astro view transitions swap the document
        document.addEventListener("astro:after-swap", apply);
      })();
    </script>
    <script
      is:inline
      defer
      data-domain="nicholascharriere.com"
      src="https://plausible.io/js/script.js"></script>
    <title>{title}</title>

    <ViewTransitions />
  </head>
  <body class="bg-page text-body max-w-[760px] mx-auto p-5 leading-normal transition-colors">
    <header>
      <div class="flex flex-row items-center justify-between gap-x-3">
        <a href="/" class="no-underline hover:no-underline">
          <h1 class="text-[1.5em] text-heading font-bold">Nicholas Charriere</h1>
        </a>
        <button
          type="button"
          onclick="window.__toggleTheme && window.__toggleTheme()"
          aria-label="Toggle light and dark theme"
          title="Toggle light / dark"
          class="cursor-pointer border-0 bg-transparent p-0 leading-none text-link hover:text-heading transition-colors"
        >
          <HalfMoon class="size-[18px] dark:hidden" />
          <SunLight class="size-[18px] hidden dark:inline" />
        </button>
      </div>
      <nav class="flex flex-row flex-wrap gap-x-3 my-4">
        <a href="/blog" class="text-link hover:underline">blog</a>
        <a href="/til" class="text-link hover:underline">til</a>
        <a href="/projects" class="text-link hover:underline">projects</a>
        <a href="/reading" class="text-link hover:underline">reading</a>
        <a href="/watching" class="text-link hover:underline">watching</a>
        <a href="/quotes" class="text-link hover:underline">quotes</a>
        <a href="https://x.com/nichochar" class="text-link hover:underline" target="_blank">@nichochar</a>
      </nav>
    </header>

    <main class="leading-relaxed mt-8">
      <slot />
    </main>
  </body>
</html>
