---
import Layout from "../layouts/Layout.astro";

// Today I Learned — small notes on things I discover.
// To add an entry: prepend an object to this array. Newest is sorted to the top
// automatically, so order here doesn't matter. `link` is optional.
type Entry = { title: string; date: Date; note: string; link?: string };

const entries: Entry[] = [
  {
    title: "Feynman's wobbly plate",
    date: new Date(2026, 7, 24), // month is 0-indexed
    note: 'After Los Alamos, Feynman felt stuck: physics had become duty, not play. He decided to quit worrying about what was "important" and just follow curiosity. In a Cornell cafeteria he watched a plate wobble as it spun through the air, worked out the motion for fun (pretty awesome), and that thread of play led him back into the problems behind the diagrams he later won the Nobel for. The lesson he kept: treat the work as play, and the serious stuff has a way of showing up anyway.',
  },
  {
    title: "Diacope",
    date: new Date(2026, 7, 7), // month is 0-indexed
    note: 'A rhetorical device: repeat a word or phrase with a word or two in between. Once you see it, it\'s everywhere. "To be or not to be" is a diacope (ABA — the repeated word bracketing an interruption), and so is "a horse, a horse, my kingdom for a horse!" (AABA). The little gap is what gives it that insistent, drumbeat quality — it\'s why the line sticks.',
  },
  {
    title: "Nomen est numen",
    date: new Date(2026, 6, 24), // month is 0-indexed
    note: 'A Latin phrase often rendered as "to name is to know." Literally it\'s closer to "the name is the divine power" (numen = divine will or presence) — the old idea that naming a thing gives you power over it, that to name is to comprehend. A modern English variant with a ring to it is "Name it to tame it".',
  },
];

const shortDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });

const sorted = [...entries].sort((a, b) => b.date.getTime() - a.date.getTime());
---

<Layout title="TIL | Nicholas Charriere">
  <h1 class="text-4xl mb-2 font-bold text-heading">TIL</h1>
  <p class="mb-6 font-light text-sm text-gray-500 dark:text-gray-400">
    Today I learned — small notes on things I discover.
  </p>
  <div class="flex flex-col divide-y divide-gray-200 mb-40">
    {
      sorted.map((entry) => (
        <div class="py-6">
          <p class="font-light text-sm text-gray-500 dark:text-gray-400 italic mb-1">
            {shortDate(entry.date)}
          </p>
          <h2 class="text-lg font-bold text-heading mb-1">{entry.title}</h2>
          <p>{entry.note}</p>
          {entry.link && (
            <p class="mt-2">
              <a
                href={entry.link}
                class="text-link hover:underline"
                target="_blank"
              >
                Learn more
              </a>
            </p>
          )}
        </div>
      ))
    }
  </div>
</Layout>
