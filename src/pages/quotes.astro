---
import Layout from "../layouts/Layout.astro";

const quotes = [
  {
    quote: "Strive not to be a success, but rather to be of value.",
    source: "Albert Einstein",
  },
  {
    quote: "The pursuit of excellence does not require justification.",
    source: "Mitchell Hashimoto",
    sourceUrl: "https://x.com/mitchellh/status/2074225453217505494"
  },
  {
    quote: "The best way to predict the future is to invent it.",
    source: "Alan Kay",
  },
  {
    quote: "I think a life properly lived is just learn, learn, learn all the time.",
    source: "Charlie Munger",
  },
  {
    quote: "The universe is change; our life is what our thoughts make it.",
    source: "Marcus Aurelius, Meditations 4.3",
  },
  {
    quote: "There's a tremendous amount of craftsmanship in between a great idea and a great product.",
    source: "Steve Jobs"
  },
  {
    quote: "Tell me to what you pay attention, and I will tell you who you are.",
    source: "Jose Ortega y Gasset"
  },
  {
    quote:
      "Premature optimization is the root of all evil (or at least most of it) in programming.",
    source: "Donald Knuth",
  },
  {
    quote: "If you want to be successful in business (in life, actually), you have to create more than you consume.",
    source: "Jeff Bezos"
  },
  {
    quote: "Don't fear moving slowly. Fear standing still.",
    source: "Chinese Proverb",
  },
  {
    quote: "Simple, correct, fast. In that order.",
    source: "Drew DeVault",
  },
  {
    quote: "Perfection is achieved, not when there is nothing more to add, but when there is nothing left to take away.",
    source: "Antoine de Saint-Exupéry"
  },
  {
    quote: "There is nothing noble in being superior to your fellow man; true nobility is being superior to your former self.",
    source: "Ernest Hemingway",
  },
  {
    quote:
      "Feedback beats planning. No grand plans, follow the gradient of user value.",
    source: "John Carmack",
  },
  {
    quote: "Focusing is about saying no.",
    source: "Steve Jobs",
  },
  {
    quote: "A master in the art of living draws no sharp distinction between his work and his play; his labor and his leisure; his mind and his body; his education and his recreation. He hardly knows which is which. He simply pursues his vision of excellence through whatever he is doing, and leaves others to determine whether he is working or playing. To himself, he always appears to be doing both.",
    source: "François Auguste de Chateaubriand"
  },
  {
    quote: "It's not what happens to you, but how you react to it that matters.",
    source: "Epictetus",
  },
  {
    quote: "However little television you watch, watch less.",
    source: "David McCullough",
  },
  {
    quote: "The impediment to action advances action. What stands in the way becomes the way.",
    source: "Marcus Aurelius",
  },
  {
    quote: "As you become an adult, you realize that things around you weren't just always there; people made them happen. But only recently have I started to internalize how much tenacity *everything* requires. That hotel, that park, that railway. The world is a museum of passion projects.",
    source: "John Collison"
  },
  {
    quote: "If you love life, don't waste time, for time is what life is made up of.",
    source: "Bruce Lee",
  },
  {
    quote:
      "The pessimist complains about the wind. The optimist expects it to change. The leader adjusts the sails.",
    source: "John Maxwell",
  },
  {
    quote: "It is only with the heart that one can see rightly; what is essential is invisible to the eye.",
    source: "Antoine de Saint-Exupéry, The Little Prince"
  },
  {
    quote: "When the enemy is making a false movement we must take good care not to interrupt him.",
    source: "Napoleon",
  },
  {
    quote: "To improve is to change. To be perfect is to have changed often.",
    source: "Winston Churchill",
  },
  {
    quote: "When the winds of change blow, some people build walls and others build windmills.",
    source: "Chinese Proverb",
  },
  {
    quote: "Good things come to those who wait, but only the things left by those who hustle.",
    source: "Attributed to Abraham Lincoln (apocryphal)"
  },
  {
    quote: "Space I can recover. Time, never.",
    source: "Napoleon"
  },
  {
    quote: "Ask for feedback on your attempts, not advice on your ideas.",
    source: "Anonymous",
  }
];
---

<Layout title="Favorite quotes | Nicholas Charriere">
  <h1 class="text-4xl mb-6 font-bold text-heading">Favorite quotes</h1>
  <div class="flex flex-col divide-y divide-gray-200 mb-40">
    {
      quotes.map((quote) => (
        <div class="py-6">
          <blockquote class="py-1 my-1">
            <p>"{quote.quote}"</p>
          </blockquote>
          <p class="font-light text-sm"> — {quote.sourceUrl ? (
            <a href={quote.sourceUrl} class="underline" target="_blank" rel="noopener noreferrer">{quote.source}</a>
          ) : quote.source}</p>
        </div>
      ))
    }
  </div>
</Layout>
